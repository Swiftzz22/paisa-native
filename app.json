{
  "expo": {
    "name": "paisa plus",
    "slug": "paisa-native",
    "scheme": "com.saniakothari.paisa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.saniakothari.paisa",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.saniakothari.paisa",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock paisa and keep your finances private."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "paisa uses the camera to scan receipts. The photo is read on your iPhone and is not uploaded.",
          "photosPermission": "paisa reads receipts you choose from your photos. They are read on your iPhone and are not uploaded.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "8f9660e5-42d9-4c77-b097-0336f170c1ed"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/8f9660e5-42d9-4c77-b097-0336f170c1ed",
      "fallbackToCacheTimeout": 0
    },
    "owner": "sania_kothari",
    "backgroundColor": "#0a0a0a"
  }
}
